<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlay_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Expanded window -->
    <LinearLayout
        android:id="@+id/window_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_overlay_window"
        android:clipToOutline="true"
        android:orientation="vertical">

        <!-- Header: drag anywhere on it to move the window -->
        <LinearLayout
            android:id="@+id/header_bar"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="4dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_drag"
                android:tint="@color/text_muted" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginStart="4dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/seg_board"
                    style="@style/SegmentItem.Compact"
                    android:text="@string/board" />

                <TextView
                    android:id="@+id/seg_practice"
                    style="@style/SegmentItem.Compact"
                    android:layout_marginStart="6dp"
                    android:text="@string/practice" />

                <TextView
                    android:id="@+id/seg_pdf"
                    style="@style/SegmentItem.Compact"
                    android:layout_marginStart="6dp"
                    android:text="@string/pdf_reader" />
            </LinearLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/btn_add"
                style="@style/IconButton.Compact"
                android:contentDescription="@string/add"
                android:src="@drawable/ic_add"
                android:tint="@color/accent" />

            <ImageButton
                android:id="@+id/btn_more"
                style="@style/IconButton.Compact"
                android:contentDescription="@string/more"
                android:src="@drawable/ic_more" />

            <ImageButton
                android:id="@+id/btn_minimize"
                style="@style/IconButton.Compact"
                android:contentDescription="@string/minimize"
                android:src="@drawable/ic_minimize" />

            <ImageButton
                android:id="@+id/btn_close"
                style="@style/IconButton.Compact"
                android:contentDescription="@string/close"
                android:src="@drawable/ic_close" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/stroke" />

        <!-- Canvas, timer, hints and the in-window menu -->
        <FrameLayout
            android:id="@+id/content_area"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <com.refpad.app.RefCanvasView
                android:id="@+id/ref_canvas"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <com.refpad.app.PdfViewerView
                android:id="@+id/pdf_viewer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />

            <!-- Timer progress: a thin line along the bottom of the pose -->
            <ProgressBar
                android:id="@+id/pb_timer"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_gravity="bottom"
                android:max="1000"
                android:progressBackgroundTint="@android:color/transparent"
                android:progressTint="@color/accent"
                android:visibility="gone" />

            <TextView
                android:id="@+id/empty_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:background="@drawable/bg_tool"
                android:drawableTop="@drawable/ic_add"
                android:drawablePadding="6dp"
                android:drawableTint="@color/accent"
                android:gravity="center"
                android:padding="16dp"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/status_chip"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_chip"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="6dp"
                android:visibility="gone">

                <ProgressBar
                    android:id="@+id/status_spinner"
                    style="?android:attr/progressBarStyleSmall"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginEnd="8dp"
                    android:indeterminateTint="@color/accent" />

                <TextView
                    android:id="@+id/tv_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/btn_undo"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_tool"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="@string/undo"
                    android:textColor="@color/accent"
                    android:textSize="12sp"
                    android:visibility="gone" />
            </LinearLayout>
        </FrameLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/stroke" />

        <!-- Board tools -->
        <HorizontalScrollView
            android:id="@+id/board_tools"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="4dp"
                android:paddingEnd="30dp">

                <ImageButton android:id="@+id/btn_add_image" style="@style/ToolCompact.Accent" android:contentDescription="@string/image" android:src="@drawable/ic_image" />
                <ImageButton android:id="@+id/btn_add_pdf" style="@style/ToolCompact.Accent" android:contentDescription="@string/pdf" android:src="@drawable/ic_pdf" />
                <View style="@style/ToolDivider" android:layout_height="22dp" android:layout_marginStart="3dp" android:layout_marginEnd="3dp" />
                <ImageButton android:id="@+id/btn_b_undo" style="@style/ToolCompact" android:contentDescription="@string/undo_tool" android:src="@drawable/ic_undo" />
                <ImageButton android:id="@+id/btn_b_redo" style="@style/ToolCompact" android:contentDescription="@string/redo" android:src="@drawable/ic_redo" />
                <View style="@style/ToolDivider" android:layout_height="22dp" android:layout_marginStart="3dp" android:layout_marginEnd="3dp" />
                <ImageButton android:id="@+id/btn_flip" style="@style/ToolCompact" android:contentDescription="@string/flip" android:src="@drawable/ic_flip" />
                <ImageButton android:id="@+id/btn_bw" style="@style/ToolCompact" android:contentDescription="@string/bw" android:src="@drawable/ic_bw" />
                <ImageButton android:id="@+id/btn_rotate" style="@style/ToolCompact" android:contentDescription="@string/rotate" android:src="@drawable/ic_rotate" />
                <ImageButton android:id="@+id/btn_crop" style="@style/ToolCompact" android:contentDescription="@string/crop" android:src="@drawable/ic_crop" />
                <ImageButton android:id="@+id/btn_copy" style="@style/ToolCompact" android:contentDescription="@string/copy" android:src="@drawable/ic_copy" />
                <ImageButton android:id="@+id/btn_paste" style="@style/ToolCompact" android:contentDescription="@string/paste" android:src="@drawable/ic_paste" />
                <ImageButton android:id="@+id/btn_delete" style="@style/ToolCompact.Danger" android:contentDescription="@string/delete" android:src="@drawable/ic_delete" />
                <View style="@style/ToolDivider" android:layout_height="22dp" android:layout_marginStart="3dp" android:layout_marginEnd="3dp" />
                <ImageButton android:id="@+id/btn_note" style="@style/ToolCompact" android:contentDescription="@string/note" android:src="@drawable/ic_note" />
                <ImageButton android:id="@+id/btn_picker" style="@style/ToolCompact" android:contentDescription="@string/colour" android:src="@drawable/ic_picker" />
                <ImageButton android:id="@+id/btn_arrange" style="@style/ToolCompact" android:contentDescription="@string/arrange" android:src="@drawable/ic_arrange" />
                <ImageButton android:id="@+id/btn_fit" style="@style/ToolCompact" android:contentDescription="@string/fit" android:src="@drawable/ic_fit" />
                <ImageButton android:id="@+id/btn_board_more" style="@style/ToolCompact" android:contentDescription="@string/more" android:src="@drawable/ic_more" android:visibility="gone" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Practice tools -->
        <HorizontalScrollView
            android:id="@+id/practice_tools"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:overScrollMode="never"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="4dp"
                android:paddingEnd="30dp">

                <LinearLayout
                    android:id="@+id/hud_card"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="4dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tv_countdown"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:fontFeatureSettings="tnum"
                        android:includeFontPadding="false"
                        android:text="2:00"
                        android:textColor="@color/accent"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/tv_pose_counter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:text="1/1"
                        android:textColor="@color/text_muted"
                        android:textSize="10sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/btn_interval"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_tool"
                    android:drawableStart="@drawable/ic_timer"
                    android:drawablePadding="4dp"
                    android:drawableTint="@color/accent"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center_vertical"
                    android:paddingStart="6dp"
                    android:paddingEnd="8dp"
                    android:text="2 min"
                    android:textColor="@color/accent"
                    android:textSize="12sp" />

                <ImageButton android:id="@+id/btn_prev" style="@style/ToolCompact" android:contentDescription="@string/prev" android:src="@drawable/ic_prev" />

                <ImageButton
                    android:id="@+id/btn_play"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="2dp"
                    android:layout_marginEnd="2dp"
                    android:background="@drawable/bg_play"
                    android:contentDescription="@string/play_pause"
                    android:scaleType="center"
                    android:src="@drawable/ic_play"
                    android:tint="@color/text_on_accent" />

                <ImageButton android:id="@+id/btn_next" style="@style/ToolCompact" android:contentDescription="@string/next" android:src="@drawable/ic_next" />
                <View style="@style/ToolDivider" android:layout_height="22dp" android:layout_marginStart="3dp" android:layout_marginEnd="3dp" />
                <ImageButton android:id="@+id/btn_p_flip" style="@style/ToolCompact" android:contentDescription="@string/flip" android:src="@drawable/ic_flip" />
                <ImageButton android:id="@+id/btn_p_bw" style="@style/ToolCompact" android:contentDescription="@string/bw" android:src="@drawable/ic_bw" />
                <ImageButton android:id="@+id/btn_class" style="@style/ToolCompact" android:contentDescription="@string/class_" android:src="@drawable/ic_class" />
                <ImageButton android:id="@+id/btn_memory" style="@style/ToolCompact" android:contentDescription="@string/memory" android:src="@drawable/ic_memory" />
                <ImageButton android:id="@+id/btn_p_add" style="@style/ToolCompact.Accent" android:contentDescription="@string/add" android:src="@drawable/ic_add" />
                <ImageButton android:id="@+id/btn_practice_more" style="@style/ToolCompact" android:contentDescription="@string/more" android:src="@drawable/ic_more" android:visibility="gone" />
            </LinearLayout>
        </HorizontalScrollView>
        <!-- PDF tools -->
        <HorizontalScrollView
            android:id="@+id/pdf_tools"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:overScrollMode="never"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="4dp"
                android:paddingEnd="30dp">

                <ImageButton android:id="@+id/btn_pdf_open" style="@style/ToolCompact.Accent" android:contentDescription="@string/open" android:src="@drawable/ic_pdf" />
                <ImageButton android:id="@+id/btn_pdf_recent" style="@style/ToolCompact" android:contentDescription="@string/recent" android:src="@drawable/ic_history" />
                <View style="@style/ToolDivider" android:layout_height="22dp" android:layout_marginStart="3dp" android:layout_marginEnd="3dp" />
                <ImageButton android:id="@+id/btn_pdf_prev" style="@style/ToolCompact" android:contentDescription="@string/prev" android:src="@drawable/ic_page_up" />

                <TextView
                    android:id="@+id/tv_pdf_page"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:fontFamily="sans-serif-medium"
                    android:fontFeatureSettings="tnum"
                    android:gravity="center"
                    android:minWidth="52dp"
                    android:text="-"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />

                <ImageButton android:id="@+id/btn_pdf_next" style="@style/ToolCompact" android:contentDescription="@string/next" android:src="@drawable/ic_page_down" />
                <View style="@style/ToolDivider" android:layout_height="22dp" android:layout_marginStart="3dp" android:layout_marginEnd="3dp" />
                <ImageButton android:id="@+id/btn_pdf_fit" style="@style/ToolCompact" android:contentDescription="@string/fit" android:src="@drawable/ic_fit" />
                <ImageButton android:id="@+id/btn_pdf_spread" style="@style/ToolCompact" android:contentDescription="@string/two_pages" android:src="@drawable/ic_spread" />
                <ImageButton android:id="@+id/btn_pdf_pages" style="@style/ToolCompact" android:contentDescription="@string/pages" android:src="@drawable/ic_pages" />
                <ImageButton android:id="@+id/btn_pdf_search" style="@style/ToolCompact" android:contentDescription="@string/search" android:src="@drawable/ic_search" />
                <ImageButton android:id="@+id/btn_pdf_snip" style="@style/ToolCompact" android:contentDescription="@string/snip" android:src="@drawable/ic_snip" />
                <ImageButton android:id="@+id/btn_pdf_bookmark" style="@style/ToolCompact" android:contentDescription="@string/bookmark" android:src="@drawable/ic_bookmark" />
                <ImageButton android:id="@+id/btn_pdf_to_board" style="@style/ToolCompact" android:contentDescription="@string/to_board" android:src="@drawable/ic_image" />
                <ImageButton android:id="@+id/btn_pdf_practice" style="@style/ToolCompact" android:contentDescription="@string/practise" android:src="@drawable/ic_timer" />
                <ImageButton android:id="@+id/btn_pdf_more" style="@style/ToolCompact" android:contentDescription="@string/more" android:src="@drawable/ic_more" android:visibility="gone" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Choosing PDF pages for the board -->
        <HorizontalScrollView
            android:id="@+id/pdf_choose_tools"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:overScrollMode="never"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="4dp"
                android:paddingEnd="30dp">

                <ImageButton android:id="@+id/btn_choose_cancel" style="@style/ToolCompact" android:contentDescription="@string/cancel" android:src="@drawable/ic_close" />
                <View style="@style/ToolDivider" android:layout_height="22dp" android:layout_marginStart="3dp" android:layout_marginEnd="3dp" />
                <ImageButton android:id="@+id/btn_choose_all" style="@style/ToolCompact" android:contentDescription="@string/all" android:src="@drawable/ic_arrange" />
                <ImageButton android:id="@+id/btn_choose_none" style="@style/ToolCompact" android:contentDescription="@string/none" android:src="@drawable/ic_reset" />
                <ImageButton android:id="@+id/btn_choose_pages" style="@style/ToolCompact" android:contentDescription="@string/pages" android:src="@drawable/ic_pdf" />

                <TextView
                    android:id="@+id/tv_choose_count"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:fontFamily="sans-serif-medium"
                    android:fontFeatureSettings="tnum"
                    android:gravity="center"
                    android:minWidth="52dp"
                    android:text="-"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />

                <ImageButton android:id="@+id/btn_choose_add" style="@style/ToolCompact.Accent" android:contentDescription="@string/add_pages" android:src="@drawable/ic_add" />
                <ImageButton android:id="@+id/btn_choose_more" style="@style/ToolCompact" android:contentDescription="@string/more" android:src="@drawable/ic_more" android:visibility="gone" />
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

    <!-- Drag this corner to resize -->
    <ImageView
        android:id="@+id/resize_handle"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_gravity="bottom|end"
        android:contentDescription="@string/resize"
        android:padding="6dp"
        android:src="@drawable/ic_resize"
        android:tint="@color/text_muted" />

    <!-- Minimised bubble -->
    <FrameLayout
        android:id="@+id/minimized_bubble"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_bubble"
        android:elevation="6dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="sans-serif-black"
            android:text="REF"
            android:textColor="@color/text_on_accent"
            android:textSize="14sp" />
    </FrameLayout>

</FrameLayout>
