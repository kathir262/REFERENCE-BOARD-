<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlay_root"
    android:layout_width="380dp"
    android:layout_height="480dp">

    <!-- Expanded Window Container -->
    <LinearLayout
        android:id="@+id/window_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/overlay_background"
        android:orientation="vertical">

        <!-- Draggable Top Header -->
        <LinearLayout
            android:id="@+id/header_bar"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:background="#2018181B"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp">

            <TextView
                android:id="@+id/tv_header_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Reference Board"
                android:textColor="@color/accent_yellow"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_floating_menu"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/btn_action_bg"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="Menu"
                android:textColor="@color/accent_yellow"
                android:textSize="10sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_mode_toggle"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/btn_action_bg"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="Ref Board"
                android:textColor="@color/text_primary"
                android:textSize="10sp" />

            <Button
                android:id="@+id/btn_minimize"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/btn_action_bg"
                android:text="—"
                android:textColor="@color/text_primary"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btn_close"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:background="@drawable/btn_action_bg"
                android:text="X"
                android:textColor="@color/text_danger"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Main Content Area: Reference Canvas, Practice HUD & In-Window Menu -->
        <FrameLayout
            android:id="@+id/content_area"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- Interactive RefPad Canvas View -->
            <com.refpad.app.RefCanvasView
                android:id="@+id/ref_canvas"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- Practice HUD Overlay Card -->
            <LinearLayout
                android:id="@+id/hud_card"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="10dp"
                android:background="@drawable/hud_background"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingTop="6dp"
                android:paddingEnd="12dp"
                android:paddingBottom="6dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tv_countdown"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="02:00"
                    android:textColor="@color/accent_yellow"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="2 MIN POSE"
                    android:textColor="@color/text_secondary"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_pose_counter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Pose 1/1"
                    android:textColor="@color/text_secondary"
                    android:textSize="8sp" />
            </LinearLayout>

            <!-- In-Window Compact Context Menu (Strictly within floating window!) -->
            <LinearLayout
                android:id="@+id/menu_card"
                android:layout_width="165dp"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:background="@drawable/menu_card_bg"
                android:orientation="vertical"
                android:padding="6dp"
                android:elevation="16dp"
                android:visibility="gone">

                <!-- Header with Title & Close -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="22dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="4dp"
                    android:paddingEnd="2dp"
                    android:layout_marginBottom="4dp">

                    <TextView
                        android:id="@+id/tv_menu_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="IMAGE"
                        android:textColor="@color/accent_yellow"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btn_menu_close"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:background="@android:color/transparent"
                        android:text="X"
                        android:textColor="@color/text_secondary"
                        android:textSize="10sp" />
                </LinearLayout>

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <Button
                            android:id="@+id/btn_menu_copy"
                            android:layout_width="match_parent"
                            android:layout_height="28dp"
                            android:background="@drawable/menu_item_bg"
                            android:gravity="start|center_vertical"
                            android:paddingStart="8dp"
                            android:text="Copy"
                            android:textColor="@color/accent_yellow"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/btn_menu_paste"
                            android:layout_width="match_parent"
                            android:layout_height="28dp"
                            android:background="@drawable/menu_item_bg"
                            android:gravity="start|center_vertical"
                            android:paddingStart="8dp"
                            android:text="Paste"
                            android:textColor="@color/accent_yellow"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/btn_menu_pdf"
                            android:layout_width="match_parent"
                            android:layout_height="28dp"
                            android:background="@drawable/menu_item_bg"
                            android:gravity="start|center_vertical"
                            android:paddingStart="8dp"
                            android:text="+ Import PDF"
                            android:textColor="@color/accent_yellow"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/btn_menu_img"
                            android:layout_width="match_parent"
                            android:layout_height="28dp"
                            android:background="@drawable/menu_item_bg"
                            android:gravity="start|center_vertical"
                            android:paddingStart="8dp"
                            android:text="+ Import Image"
                            android:textColor="@color/text_primary"
                            android:textSize="11sp" />

                        <Button
                            android:id="@+id/btn_menu_flip"
                            android:layout_width="match_parent"
                            android:layout_height="28dp"
                            android:background="@drawable/menu_item_bg"
                            android:gravity="start|center_vertical"
                            android:paddingStart="8dp"
                            android:text="Flip Horizontal"
                            android:textColor="@color/text_primary"
                            android:textSize="11sp" />

                        <Button
                            android:id="@+id/btn_menu_rotate"
                            android:layout_width="match_parent"
                            android:layout_height="28dp"
                            android:background="@drawable/menu_item_bg"
                            android:gravity="start|center_vertical"
                            android:paddingStart="8dp"
                            android:text="Rotate 90 CW"
                            android:textColor="@color/text_primary"
                            android:textSize="11sp" />

                        <Button
                            android:id="@+id/btn_menu_bw"
                            android:layout_width="match_parent"
                            android:layout_height="28dp"
                            android:background="@drawable/menu_item_bg"
                            android:gravity="start|center_vertical"
                            android:paddingStart="8dp"
                            android:text="Toggle B&amp;W"
                            android:textColor="@color/text_primary"
                            android:textSize="11sp" />

                        <Button
                            android:id="@+id/btn_menu_practice"
                            android:layout_width="match_parent"
                            android:layout_height="28dp"
                            android:background="@drawable/menu_item_bg"
                            android:gravity="start|center_vertical"
                            android:paddingStart="8dp"
                            android:text="Send to Practice"
                            android:textColor="@color/text_primary"
                            android:textSize="11sp" />

                        <Button
                            android:id="@+id/btn_menu_arrange"
                            android:layout_width="match_parent"
                            android:layout_height="28dp"
                            android:background="@drawable/menu_item_bg"
                            android:gravity="start|center_vertical"
                            android:paddingStart="8dp"
                            android:text="Auto Arrange"
                            android:textColor="@color/text_primary"
                            android:textSize="11sp" />

                        <Button
                            android:id="@+id/btn_menu_reset"
                            android:layout_width="match_parent"
                            android:layout_height="28dp"
                            android:background="@drawable/menu_item_bg"
                            android:gravity="start|center_vertical"
                            android:paddingStart="8dp"
                            android:text="Reset Transforms"
                            android:textColor="@color/text_primary"
                            android:textSize="11sp" />

                        <Button
                            android:id="@+id/btn_menu_del"
                            android:layout_width="match_parent"
                            android:layout_height="28dp"
                            android:background="@drawable/menu_item_bg"
                            android:gravity="start|center_vertical"
                            android:paddingStart="8dp"
                            android:text="Delete Reference"
                            android:textColor="@color/text_danger"
                            android:textSize="11sp" />

                        <Button
                            android:id="@+id/btn_menu_clear"
                            android:layout_width="match_parent"
                            android:layout_height="28dp"
                            android:background="@drawable/menu_item_bg"
                            android:gravity="start|center_vertical"
                            android:paddingStart="8dp"
                            android:text="Clear Board"
                            android:textColor="@color/text_danger"
                            android:textSize="11sp" />

                    </LinearLayout>
                </ScrollView>
            </LinearLayout>

        </FrameLayout>

        <!-- Bottom Controls Bar -->
        <FrameLayout
            android:id="@+id/bottom_bar"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:background="#2018181B"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <!-- Reference Board Controls -->
            <HorizontalScrollView
                android:id="@+id/dock_ref_scroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scrollbars="none"
                android:fillViewport="true">

                <LinearLayout
                    android:id="@+id/ref_controls"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_pdf_ref"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:layout_margin="2dp"
                        android:background="@drawable/btn_action_bg"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:text="+ PDF"
                        android:textColor="@color/accent_yellow"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btn_add_ref"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:layout_margin="2dp"
                        android:background="@drawable/btn_action_bg"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:text="+ Image"
                        android:textColor="@color/text_primary"
                        android:textSize="10sp" />

                    <Button
                        android:id="@+id/btn_copy_ref"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:layout_margin="2dp"
                        android:background="@drawable/btn_action_bg"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:text="Copy"
                        android:textColor="@color/accent_yellow"
                        android:textSize="10sp" />

                    <Button
                        android:id="@+id/btn_paste_ref"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:layout_margin="2dp"
                        android:background="@drawable/btn_action_bg"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:text="Paste"
                        android:textColor="@color/accent_yellow"
                        android:textSize="10sp" />

                    <Button
                        android:id="@+id/btn_flip_ref"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:layout_margin="2dp"
                        android:background="@drawable/btn_action_bg"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:text="@string/btn_flip"
                        android:textColor="@color/text_primary"
                        android:textSize="10sp" />

                    <Button
                        android:id="@+id/btn_bw_ref"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:layout_margin="2dp"
                        android:background="@drawable/btn_action_bg"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:text="@string/btn_mono"
                        android:textColor="@color/text_primary"
                        android:textSize="10sp" />

                    <Button
                        android:id="@+id/btn_reset_ref"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:layout_margin="2dp"
                        android:background="@drawable/btn_action_bg"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:text="@string/btn_reset"
                        android:textColor="@color/text_primary"
                        android:textSize="10sp" />

                    <Button
                        android:id="@+id/btn_del_ref"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:layout_margin="2dp"
                        android:background="@drawable/btn_action_bg"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:text="@string/btn_del"
                        android:textColor="@color/text_danger"
                        android:textSize="10sp" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- Practice Mode Controls -->
            <HorizontalScrollView
                android:id="@+id/dock_practice_scroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scrollbars="none"
                android:fillViewport="true"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/practice_controls"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_interval"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:layout_margin="2dp"
                        android:background="@drawable/btn_action_bg"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:text="2m"
                        android:textColor="@color/accent_yellow"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btn_pdf_practice"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:layout_margin="2dp"
                        android:background="@drawable/btn_action_bg"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:text="+ PDF"
                        android:textColor="@color/accent_yellow"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btn_prev_pose"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:layout_margin="2dp"
                        android:background="@drawable/btn_action_bg"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:text="@string/btn_prev"
                        android:textColor="@color/text_primary"
                        android:textSize="10sp" />

                    <Button
                        android:id="@+id/btn_play_pause"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:layout_margin="2dp"
                        android:background="@drawable/btn_action_bg"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:text="@string/btn_play"
                        android:textColor="@color/accent_yellow"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btn_next_pose"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:layout_margin="2dp"
                        android:background="@drawable/btn_action_bg"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:text="@string/btn_next"
                        android:textColor="@color/text_primary"
                        android:textSize="10sp" />

                    <Button
                        android:id="@+id/btn_flip_practice"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:layout_margin="2dp"
                        android:background="@drawable/btn_action_bg"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:text="@string/btn_flip"
                        android:textColor="@color/text_primary"
                        android:textSize="10sp" />

                    <Button
                        android:id="@+id/btn_bw_practice"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:layout_margin="2dp"
                        android:background="@drawable/btn_action_bg"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:text="@string/btn_mono"
                        android:textColor="@color/text_primary"
                        android:textSize="10sp" />
                </LinearLayout>
            </HorizontalScrollView>

        </FrameLayout>

    </LinearLayout>

    <!-- Corner Resize Handle (Bottom Right) -->
    <View
        android:id="@+id/resize_handle"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="bottom|end"
        android:background="#20FFFFFF" />

    <!-- Minimized Floating Bubble -->
    <FrameLayout
        android:id="@+id/minimized_bubble"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center"
        android:background="@drawable/minimized_bubble_bg"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="REF"
            android:textColor="@color/text_dark"
            android:textSize="13sp"
            android:textStyle="bold" />
    </FrameLayout>

</FrameLayout>
