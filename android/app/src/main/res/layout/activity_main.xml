<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Board / practice canvas (padding keeps "fit" clear of the bars) -->
    <com.refpad.app.RefCanvasView
        android:id="@+id/ref_canvas"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingTop="80dp"
        android:paddingBottom="100dp" />

    <!-- PDF reader (shown in PDF mode) -->
    <com.refpad.app.PdfViewerView
        android:id="@+id/pdf_viewer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingTop="80dp"
        android:paddingBottom="100dp"
        android:visibility="gone" />

    <!-- Keeps the clock and status icons readable over pages and images -->
    <View
        android:id="@+id/status_scrim"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_gravity="top"
        android:background="#E60E0E10"
        android:elevation="6dp" />

    <!-- Top bar -->
    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_gravity="top"
        android:layout_marginStart="12dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_bar"
        android:elevation="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/tv_app_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:text="@string/app_name"
            android:textColor="@color/accent"
            android:textSize="20sp" />

        <!-- Mode buttons, with space between them -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:layout_marginStart="@dimen/seg_margin_start"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/seg_board"
                style="@style/SegmentItem"
                android:text="@string/board" />

            <TextView
                android:id="@+id/seg_practice"
                style="@style/SegmentItem"
                android:layout_marginStart="@dimen/seg_gap"
                android:text="@string/practice" />

            <TextView
                android:id="@+id/seg_pdf"
                style="@style/SegmentItem"
                android:layout_marginStart="@dimen/seg_gap"
                android:text="@string/pdf_reader" />
        </LinearLayout>

        <!-- Practice timer sits in the middle of the bar, so it never covers the pose -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/hud_card"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tv_countdown"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:fontFeatureSettings="tnum"
                    android:text="2:00"
                    android:textColor="@color/accent"
                    android:textSize="27sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_pose_counter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:text="Pose 1 of 1"
                        android:textColor="@color/text_secondary"
                        android:textSize="12.5sp" />

                    <ProgressBar
                        android:id="@+id/pb_timer"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="130dp"
                        android:layout_height="4dp"
                        android:layout_marginTop="6dp"
                        android:max="1000"
                        android:progressBackgroundTint="@color/stroke_strong"
                        android:progressTint="@color/accent" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <ImageButton
            android:id="@+id/btn_add"
            style="@style/IconButton"
            android:contentDescription="@string/add"
            android:src="@drawable/ic_add"
            android:tint="@color/accent" />

        <ImageButton
            android:id="@+id/btn_float"
            style="@style/IconButton"
            android:layout_marginStart="2dp"
            android:contentDescription="@string/float_window"
            android:src="@drawable/ic_float" />

        <ImageButton
            android:id="@+id/btn_more"
            style="@style/IconButton"
            android:layout_marginStart="2dp"
            android:contentDescription="@string/more"
            android:src="@drawable/ic_more" />
    </LinearLayout>

    <!-- Empty state -->
    <LinearLayout
        android:id="@+id/empty_card"
        android:layout_width="@dimen/empty_card_width"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_card"
        android:elevation="8dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="28dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/empty_icon"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/bg_icon_circle"
            android:contentDescription="@null"
            android:scaleType="center"
            android:src="@drawable/ic_image"
            android:tint="@color/accent" />

        <TextView
            android:id="@+id/empty_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:textColor="@color/text_primary"
            android:textSize="21sp" />

        <TextView
            android:id="@+id/empty_body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/empty_primary"
            style="@style/ButtonPrimary"
            android:layout_marginTop="24dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/empty_secondary"
                style="@style/ButtonSecondary" />

            <TextView
                android:id="@+id/empty_tertiary"
                style="@style/ButtonSecondary"
                android:layout_marginStart="10dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/empty_link"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_tool"
            android:fontFamily="sans-serif-medium"
            android:padding="10dp"
            android:textColor="@color/accent"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="@string/tip"
            android:textColor="@color/text_muted"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Progress / undo chip -->
    <LinearLayout
        android:id="@+id/status_chip"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="104dp"
        android:background="@drawable/bg_chip"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="8dp"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/status_spinner"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginEnd="10dp"
            android:indeterminateTint="@color/accent" />

        <TextView
            android:id="@+id/tv_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:textColor="@color/text_primary"
            android:textSize="13.5sp" />

        <TextView
            android:id="@+id/btn_undo"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/bg_tool"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="@string/undo"
            android:textColor="@color/accent"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Bottom toolbar -->
    <FrameLayout
        android:id="@+id/toolbar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_bar"
        android:elevation="8dp"
        android:padding="6dp">

        <HorizontalScrollView
            android:id="@+id/board_tools"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btn_add_image"
                    style="@style/Tool.Accent"
                    android:drawableTop="@drawable/ic_image"
                    android:text="@string/image" />

                <TextView
                    android:id="@+id/btn_add_pdf"
                    style="@style/Tool.Accent"
                    android:drawableTop="@drawable/ic_pdf"
                    android:text="@string/pdf" />

                <View style="@style/ToolDivider" />

                <TextView
                    android:id="@+id/btn_b_undo"
                    style="@style/Tool"
                    android:drawableTop="@drawable/ic_undo"
                    android:text="@string/undo_tool" />

                <TextView
                    android:id="@+id/btn_b_redo"
                    style="@style/Tool"
                    android:drawableTop="@drawable/ic_redo"
                    android:text="@string/redo" />

                <View style="@style/ToolDivider" />

                <TextView
                    android:id="@+id/btn_flip"
                    style="@style/Tool"
                    android:drawableTop="@drawable/ic_flip"
                    android:text="@string/flip" />

                <TextView
                    android:id="@+id/btn_bw"
                    style="@style/Tool"
                    android:drawableTop="@drawable/ic_bw"
                    android:text="@string/bw" />

                <TextView
                    android:id="@+id/btn_rotate"
                    style="@style/Tool"
                    android:drawableTop="@drawable/ic_rotate"
                    android:text="@string/rotate" />

                <TextView
                    android:id="@+id/btn_crop"
                    style="@style/Tool"
                    android:drawableTop="@drawable/ic_crop"
                    android:text="@string/crop" />

                <TextView
                    android:id="@+id/btn_copy"
                    style="@style/Tool"
                    android:drawableTop="@drawable/ic_copy"
                    android:text="@string/copy" />

                <TextView
                    android:id="@+id/btn_paste"
                    style="@style/Tool"
                    android:drawableTop="@drawable/ic_paste"
                    android:text="@string/paste" />

                <TextView
                    android:id="@+id/btn_delete"
                    style="@style/Tool.Danger"
                    android:drawableTop="@drawable/ic_delete"
                    android:text="@string/delete" />

                <View style="@style/ToolDivider" />

                <TextView
                    android:id="@+id/btn_note"
                    style="@style/Tool"
                    android:drawableTop="@drawable/ic_note"
                    android:text="@string/note" />

                <TextView
                    android:id="@+id/btn_picker"
                    style="@style/Tool"
                    android:drawableTop="@drawable/ic_picker"
                    android:text="@string/colour" />

                <TextView
                    android:id="@+id/btn_arrange"
                    style="@style/Tool"
                    android:drawableTop="@drawable/ic_arrange"
                    android:text="@string/arrange" />

                <TextView
                    android:id="@+id/btn_fit"
                    style="@style/Tool"
                    android:drawableTop="@drawable/ic_fit"
                    android:text="@string/fit" />

                <TextView
                    android:id="@+id/btn_board_more"
                    style="@style/Tool"
                    android:drawableTop="@drawable/ic_more"
                    android:text="@string/more"
                    android:visibility="gone" />
            </LinearLayout>
        </HorizontalScrollView>

        <HorizontalScrollView
            android:id="@+id/practice_tools"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:overScrollMode="never"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btn_interval"
                    style="@style/Tool.Accent"
                    android:drawableTop="@drawable/ic_timer"
                    android:minWidth="72dp"
                    android:text="2 min" />

                <View style="@style/ToolDivider" />

                <TextView
                    android:id="@+id/btn_prev"
                    style="@style/Tool"
                    android:drawableTop="@drawable/ic_prev"
                    android:text="@string/prev" />

                <ImageButton
                    android:id="@+id/btn_play"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_play"
                    android:contentDescription="@string/play_pause"
                    android:scaleType="center"
                    android:src="@drawable/ic_play"
                    android:tint="@color/text_on_accent" />

                <TextView
                    android:id="@+id/btn_next"
                    style="@style/Tool"
                    android:drawableTop="@drawable/ic_next"
                    android:text="@string/next" />

                <View style="@style/ToolDivider" />

                <TextView
                    android:id="@+id/btn_p_flip"
                    style="@style/Tool"
                    android:drawableTop="@drawable/ic_flip"
                    android:text="@string/flip" />

                <TextView
                    android:id="@+id/btn_p_bw"
                    style="@style/Tool"
                    android:drawableTop="@drawable/ic_bw"
                    android:text="@string/bw" />

                <View style="@style/ToolDivider" />

                <TextView
                    android:id="@+id/btn_class"
                    style="@style/Tool"
                    android:drawableTop="@drawable/ic_class"
                    android:text="@string/class_" />

                <TextView
                    android:id="@+id/btn_memory"
                    style="@style/Tool"
                    android:drawableTop="@drawable/ic_memory"
                    android:text="@string/memory" />

                <TextView
                    android:id="@+id/btn_p_add"
                    style="@style/Tool.Accent"
                    android:drawableTop="@drawable/ic_add"
                    android:text="@string/add" />

                <TextView
                    android:id="@+id/btn_practice_more"
                    style="@style/Tool"
                    android:drawableTop="@drawable/ic_more"
                    android:text="@string/more"
                    android:visibility="gone" />
            </LinearLayout>
        </HorizontalScrollView>

        <HorizontalScrollView
            android:id="@+id/pdf_tools"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:overScrollMode="never"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btn_pdf_open"
                    style="@style/Tool.Accent"
                    android:drawableTop="@drawable/ic_pdf"
                    android:text="@string/open" />

                <TextView
                    android:id="@+id/btn_pdf_recent"
                    style="@style/Tool"
                    android:drawableTop="@drawable/ic_history"
                    android:text="@string/recent" />

                <View style="@style/ToolDivider" />

                <TextView
                    android:id="@+id/btn_pdf_prev"
                    style="@style/Tool"
                    android:drawableTop="@drawable/ic_page_up"
                    android:text="@string/prev" />

                <TextView
                    android:id="@+id/tv_pdf_page"
                    android:layout_width="wrap_content"
                    android:layout_height="58dp"
                    android:fontFamily="sans-serif-medium"
                    android:fontFeatureSettings="tnum"
                    android:gravity="center"
                    android:minWidth="84dp"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:text="-"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/btn_pdf_next"
                    style="@style/Tool"
                    android:drawableTop="@drawable/ic_page_down"
                    android:text="@string/next" />

                <View style="@style/ToolDivider" />

                <TextView
                    android:id="@+id/btn_pdf_fit"
                    style="@style/Tool"
                    android:drawableTop="@drawable/ic_fit"
                    android:text="@string/fit" />

                <TextView
                    android:id="@+id/btn_pdf_spread"
                    style="@style/Tool"
                    android:drawableTop="@drawable/ic_spread"
                    android:text="@string/two_pages" />

                <TextView
                    android:id="@+id/btn_pdf_pages"
                    style="@style/Tool"
                    android:drawableTop="@drawable/ic_pages"
                    android:text="@string/pages" />

                <TextView
                    android:id="@+id/btn_pdf_search"
                    style="@style/Tool"
                    android:drawableTop="@drawable/ic_search"
                    android:text="@string/search" />

                <TextView
                    android:id="@+id/btn_pdf_snip"
                    style="@style/Tool"
                    android:drawableTop="@drawable/ic_snip"
                    android:text="@string/snip" />

                <TextView
                    android:id="@+id/btn_pdf_bookmark"
                    style="@style/Tool"
                    android:drawableTop="@drawable/ic_bookmark"
                    android:text="@string/bookmark" />

                <View style="@style/ToolDivider" />

                <TextView
                    android:id="@+id/btn_pdf_to_board"
                    style="@style/Tool"
                    android:drawableTop="@drawable/ic_image"
                    android:text="@string/to_board" />

                <TextView
                    android:id="@+id/btn_pdf_practice"
                    style="@style/Tool"
                    android:drawableTop="@drawable/ic_timer"
                    android:text="@string/practise" />

                <TextView
                    android:id="@+id/btn_pdf_more"
                    style="@style/Tool"
                    android:drawableTop="@drawable/ic_more"
                    android:text="@string/more"
                    android:visibility="gone" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Choosing PDF pages for the board -->
        <HorizontalScrollView
            android:id="@+id/pdf_choose_tools"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:overScrollMode="never"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btn_choose_cancel"
                    style="@style/Tool"
                    android:drawableTop="@drawable/ic_close"
                    android:text="@string/cancel" />

                <View style="@style/ToolDivider" />

                <TextView
                    android:id="@+id/btn_choose_all"
                    style="@style/Tool"
                    android:drawableTop="@drawable/ic_arrange"
                    android:text="@string/all" />

                <TextView
                    android:id="@+id/btn_choose_none"
                    style="@style/Tool"
                    android:drawableTop="@drawable/ic_reset"
                    android:text="@string/none" />

                <TextView
                    android:id="@+id/btn_choose_pages"
                    style="@style/Tool"
                    android:drawableTop="@drawable/ic_pdf"
                    android:text="@string/pages" />

                <TextView
                    android:id="@+id/tv_choose_count"
                    android:layout_width="wrap_content"
                    android:layout_height="58dp"
                    android:fontFamily="sans-serif-medium"
                    android:fontFeatureSettings="tnum"
                    android:gravity="center"
                    android:minWidth="76dp"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:text="-"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/btn_choose_add"
                    style="@style/Tool.Accent"
                    android:drawableTop="@drawable/ic_add"
                    android:text="@string/add_pages" />

                <TextView
                    android:id="@+id/btn_choose_more"
                    style="@style/Tool"
                    android:drawableTop="@drawable/ic_more"
                    android:text="@string/more"
                    android:visibility="gone" />
            </LinearLayout>
        </HorizontalScrollView>
    </FrameLayout>

</FrameLayout>
