<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <!-- Interactive Infinite Canvas (Base Layer) -->
    <com.refpad.app.RefCanvasView
        android:id="@+id/ref_canvas"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Sleek Empty State (Centered when no references loaded) -->
    <LinearLayout
        android:id="@+id/empty_state_view"
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/hud_background"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/accent_yellow"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="20dp"
            android:gravity="center"
            android:text="Infinite reference canvas and gesture practice for digital artists. Long press anywhere for context menus."
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:lineSpacingExtra="2dp" />

        <Button
            android:id="@+id/btn_empty_sample"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/btn_yellow_bg"
            android:text="Load Sample References"
            android:textColor="@color/text_dark"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_empty_pdf"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/btn_action_bg"
            android:text="Import PDF Art Book"
            android:textColor="@color/accent_yellow"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_empty_images"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/btn_action_bg"
            android:text="@string/btn_select_images"
            android:textColor="@color/text_primary"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_empty_folder"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@drawable/btn_action_bg"
            android:text="@string/btn_select_folder"
            android:textColor="@color/text_primary"
            android:textSize="12sp" />

    </LinearLayout>

    <!-- Top App Bar -->
    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_gravity="top"
        android:background="#D0121214"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <TextView
            android:id="@+id/tv_app_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textColor="@color/accent_yellow"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_top_pdf"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/pill_button_bg"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="+ PDF"
            android:textColor="@color/accent_yellow"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_mode_toggle"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/pill_button_bg"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="Ref Board"
            android:textColor="@color/text_primary"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btn_float_overlay"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/btn_yellow_bg"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="Float Window"
            android:textColor="@color/text_dark"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_top_menu"
            android:layout_width="36dp"
            android:layout_height="32dp"
            android:background="@drawable/pill_button_bg"
            android:text="≡"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />

    </LinearLayout>

    <!-- Practice Mode HUD Overlay Card -->
    <LinearLayout
        android:id="@+id/hud_card"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="16dp"
        android:layout_marginTop="68dp"
        android:background="@drawable/hud_background"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_countdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="02:00"
            android:textColor="@color/accent_yellow"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="2 MIN POSE"
            android:textColor="@color/text_secondary"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_pose_counter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Pose 1/1"
            android:textColor="@color/text_secondary"
            android:textSize="9sp" />
    </LinearLayout>

    <!-- Bottom Floating Dock (Centered Glass Pill) -->
    <FrameLayout
        android:id="@+id/bottom_dock_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="20dp"
        android:background="@drawable/dock_background"
        android:padding="6dp">

        <!-- Reference Mode Dock Toolbar -->
        <LinearLayout
            android:id="@+id/dock_ref_controls"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="visible">

            <Button
                android:id="@+id/btn_dock_menu"
                android:layout_width="34dp"
                android:layout_height="32dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/pill_button_bg"
                android:text="≡"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btn_dock_pdf"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/pill_button_bg"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="+ PDF"
                android:textColor="@color/accent_yellow"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_dock_add"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/pill_button_bg"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="+ Image"
                android:textColor="@color/text_primary"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btn_dock_flip"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/pill_button_bg"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/btn_flip"
                android:textColor="@color/text_primary"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btn_dock_bw"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/pill_button_bg"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/btn_mono"
                android:textColor="@color/text_primary"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btn_dock_reset"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/pill_button_bg"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/btn_reset"
                android:textColor="@color/text_primary"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btn_dock_del"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/pill_button_bg"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/btn_del"
                android:textColor="@color/text_danger"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btn_dock_to_practice"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/btn_yellow_bg"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="Practice"
                android:textColor="@color/text_dark"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Practice Mode Dock Toolbar -->
        <LinearLayout
            android:id="@+id/dock_practice_controls"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <Button
                android:id="@+id/btn_dock_interval"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/pill_button_bg"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="2m"
                android:textColor="@color/accent_yellow"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_dock_practice_pdf"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/pill_button_bg"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="+ PDF"
                android:textColor="@color/accent_yellow"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_dock_prev"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/pill_button_bg"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/btn_prev"
                android:textColor="@color/text_primary"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btn_dock_play_pause"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/pill_button_bg"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/btn_play"
                android:textColor="@color/accent_yellow"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_dock_next"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/pill_button_bg"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/btn_next"
                android:textColor="@color/text_primary"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btn_dock_flip_p"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/pill_button_bg"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/btn_flip"
                android:textColor="@color/text_primary"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btn_dock_bw_p"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/pill_button_bg"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/btn_mono"
                android:textColor="@color/text_primary"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btn_dock_to_ref"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/btn_yellow_bg"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="Ref Board"
                android:textColor="@color/text_dark"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

    </FrameLayout>

</FrameLayout>
